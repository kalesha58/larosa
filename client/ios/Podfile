# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AwesomeProject' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Clang VFS overlay breaks when the project path contains an apostrophe
    # (e.g. /Volumes/Baig's/...). RN generates single-quoted YAML paths which
    # terminate early at the apostrophe. Re-quote those paths with double quotes.
    vfs_path = File.join(__dir__, 'Pods', 'React-Core-prebuilt', 'React-VFS.yaml')
    template_path = File.join(__dir__, 'Pods', 'React-Core-prebuilt', 'React.xcframework', 'React-VFS-template.yaml')
    if File.exist?(template_path) && __dir__.include?("'")
      root = File.join(__dir__, 'Pods', 'React-Core-prebuilt', 'React.xcframework')
      template = File.read(template_path)
      fixed = template.gsub(/'\$\{ROOT_PATH\}([^']*)'/) { "\"#{root}#{$1}\"" }
      File.write(vfs_path, fixed)
      Pod::UI.puts "Fixed React-VFS.yaml quoting for apostrophe in project path".yellow
    end
  end
end
